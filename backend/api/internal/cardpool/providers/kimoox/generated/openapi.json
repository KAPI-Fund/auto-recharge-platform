  "paths": {
    "/openapi/v1/card-bins/query": {
      "post": {
        "operationId": "KimooxCardBins",
        "summary": "获取卡 BIN",
        "description": "获取当前 API 用户所属商户已配置、已启用、平台 BIN 也启用的卡 BIN 列表。开卡配额按商户统一管理，不按单个 BIN 分别设置；统一配额以 data.quota 为准。为兼容老客户，列表中的 maxCardCount 和 issuedCardCount 字段继续保留。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KimooxRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "业务响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KimooxResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "401": {
            "description": "API Key 无效或权限未开启"
          },
          "403": {
            "description": "签名或 IP 白名单校验失败"
          },
          "500": {
            "description": "系统异常"
          }
        }
      }
    },
