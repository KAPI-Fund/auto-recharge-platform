{
  "openapi": "3.0.3",
  "info": {
    "title": "Kimoox VCC Open API Adapter",
    "version": "2026-08-28",
    "description": "Compatibility schema reconstructed from the published Kimoox VCC Open API documentation. Kimoox does not currently publish a downloadable openapi.json path; this file mirrors the documented endpoints used by the adapter. Source: https://docs.kimoox.com/"
  },
  "servers": [
    {
      "url": "https://card.kimoox.com"
    }
