# Copy this file to .env.production and replace every CHANGE_ME value.
# Keep .env.production out of Git. It is ignored by the repository.

BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=recharge
POSTGRES_USER=recharge
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_SECONDARY_PASSWORD=CHANGE_ME_SECONDARY_PASSWORD
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_API_TOKEN
WORKER_API_TOKEN=CHANGE_ME_WORKER_API_TOKEN
ADMIN_TOKEN_SECRET=CHANGE_ME_ADMIN_TOKEN_SECRET
SESSION_ENCRYPTION_KEY=CHANGE_ME_SESSION_ENCRYPTION_KEY
# Optional comma-separated legacy keys during a controlled key rotation.
SESSION_ENCRYPTION_KEY_FALLBACKS=

# Replace with the public HTTPS origin served by the reverse proxy.
CORS_ORIGINS=https://your-domain.example
PUBLIC_BASE_URL=https://your-domain.example

# Intentionally enabled for temporary in-site CDK purchase testing.
STORE_DEBUG_MODE=1

# The Worker still executes the original browser flow.
DEFAULT_RECHARGE_MODE=browser
RECHARGE_QUEUED_TIMEOUT_SECONDS=600
RECHARGE_TASK_LEASE_TIMEOUT_SECONDS=60
BROWSER_HEADLESS=1
LEGACY_HEADFUL=0
CHECKOUT_MODE=api
BROWSER_POOL=1
BROWSER_POOL_SIZE=2
BROWSER_POOL_BASE_PORT=19222
BROWSER_CHECKOUT_URL=
PROXY=

# Leave empty only while STORE_DEBUG_MODE=1. Fill these before real Stripe sales.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-domain.example/recharge?payment=success&order_id={ORDER_ID}
STRIPE_CANCEL_URL=https://your-domain.example/recharge?payment=cancelled&order_id={ORDER_ID}

# Customer email notifications. The SMTP password is secret; never commit it.
EMAIL_ENABLED=false
EMAIL_NOTIFY_PURCHASE=true
EMAIL_NOTIFY_REDEEM=true
EMAIL_SITE_NAME=KC GPT自动充值系统
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=no-reply@your-domain.example
EMAIL_SMTP_FROM_NAME=KC GPT自动充值系统
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=10

UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_CREATE_PATH=/pay
UPSTREAM_STATUS_PATH=/tasks/:id

HCAPTCHA_SOLVER_ENABLED=1
HCAPTCHA_VLM_API_KEY=
HCAPTCHA_VLM_BASE_URL=https://api.openai.com/v1
HCAPTCHA_VLM_MODEL=gpt-5.5
HCAPTCHA_CAPTCHA_PLATFORM_API_KEY=
HCAPTCHA_CAPTCHA_PLATFORM_API_URL=https://api.capsolver.com
HCAPTCHA_CAPTCHA_PLATFORM_TIMEOUT=180

POOL_EMAIL_IMAP_HOST=outlook.office365.com
POOL_EMAIL_IMAP_PORT=993
POOL_EMAIL_INCLUDE_JUNK=1
