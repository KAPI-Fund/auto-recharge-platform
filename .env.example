# Web/API
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# Credentials: replace all development defaults before deployment.
ADMIN_API_TOKEN=dev-admin-token
WORKER_API_TOKEN=dev-worker-token
SESSION_ENCRYPTION_KEY=change-this-session-key
# Optional comma-separated keys used only to read data encrypted by older deployments.
SESSION_ENCRYPTION_KEY_FALLBACKS=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_SECONDARY_PASSWORD=admin123

# Platform storefront payment. Debug mode issues a CDK immediately without Stripe.
PUBLIC_BASE_URL=http://localhost:3000
STORE_DEBUG_MODE=1
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/recharge?payment=success&order_id={ORDER_ID}
STRIPE_CANCEL_URL=http://localhost:3000/recharge?payment=cancelled

# Customer email notifications. Configure in /admin/settings or here before startup.
EMAIL_ENABLED=false
EMAIL_NOTIFY_PURCHASE=true
EMAIL_NOTIFY_REDEEM=true
EMAIL_SITE_NAME=KC GPT自动充值系统
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_FROM_NAME=KC GPT自动充值系统
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=10

# Queue execution: browser runs the legacy Playwright worker; use dry_run only for a local queue smoke test.
DEFAULT_RECHARGE_MODE=browser
QUEUE_NAME=recharge:tasks
RECHARGE_QUEUED_TIMEOUT_SECONDS=600
RECHARGE_TASK_LEASE_TIMEOUT_SECONDS=60

# Third-party recharge provider.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_CREATE_PATH=/pay
UPSTREAM_STATUS_PATH=/tasks/:id
UPSTREAM_POLL_INTERVAL_MS=3000
UPSTREAM_POLL_ATTEMPTS=40

# Playwright browser provider.
BROWSER_CHECKOUT_URL=
BROWSER_HEADLESS=1
PROXY=
RUNTIME_DIR=./runtime
CHECKOUT_MODE=api
PAYMENT_TEST_MODE=
LEGACY_HEADFUL=0
CHROMIUM_CHANNEL=
LEGACY_MAX_ATTEMPTS=3
LEGACY_PROCESS_TIMEOUT_MS=900000

# Legacy hCaptcha worker configuration.
HCAPTCHA_SOLVER_ENABLED=1
HCAPTCHA_VLM_API_KEY=
HCAPTCHA_VLM_BASE_URL=https://api.openai.com/v1
HCAPTCHA_VLM_MODEL=gpt-5.5
HCAPTCHA_VLM_TIMEOUT=45
HCAPTCHA_SOLVER_TIMEOUT=240
HCAPTCHA_SOLVER_NO_VLM=0
HCAPTCHA_CDP_PORT=9222
HCAPTCHA_CAPTCHA_PLATFORM_API_KEY=
HCAPTCHA_CAPTCHA_PLATFORM_API_URL=https://api.capsolver.com
HCAPTCHA_CAPTCHA_PLATFORM_TIMEOUT=180
